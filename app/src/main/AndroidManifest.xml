<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Watching the network needs no prompt: it is a normal permission. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The listener opens a socket for the hub: a normal permission, granted at install. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The one foreground service, of the special-use type (ADR-CVM-003), and its notice. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- To start the listener again after a restart or an update (ADR-CVM-003). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- From Android 11, an app sees another only if it says so; this lets the button open Tailscale. -->
    <queries>
        <package android:name="com.tailscale.ipn" />
    </queries>

    <!-- Nothing the app keeps is backed up or moved to a new phone, which must pair again
         (ADR-CVM-009). allowBackup and fullBackupContent cover Android 8 to 11; from Android 12
         only the data extraction rules stop a transfer from phone to phone. -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="claude-voice">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Special use, not data sync, which Android 15 stops after six hours a day (ADR-CVM-003). -->
        <service
            android:name=".ListenerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A listener for the owner's own assistant hub" />
        </service>
        <!-- Only the system sends these two; the receiver starts only a named, paired phone. -->
        <receiver
            android:name=".ComeBackReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
