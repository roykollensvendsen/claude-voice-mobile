<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Watching the network needs no prompt: it is a normal permission. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- From Android 11, an app sees another only if it says so; this lets the button open Tailscale. -->
    <queries>
        <package android:name="com.tailscale.ipn" />
    </queries>

    <!-- Nothing the app keeps is backed up or moved to a new phone, which must pair again
         (ADR-CVM-009). allowBackup and fullBackupContent cover Android 8 to 11; from Android 12
         only the data extraction rules stop a transfer from phone to phone. -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="claude-voice">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
