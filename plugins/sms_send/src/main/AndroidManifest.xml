<?xml version="1.0" encoding="utf-8"?>
<!-- Sending a text for the owner (messages-v1 §8, choice B). Only a build that names `sms_send` holds this. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Restricted: after a sideloaded install, Android may first ask for "Allow restricted settings". -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <application>
        <!-- Android's sent and delivered reports. Not exported: only this app and the system reach it. -->
        <receiver
            android:name="org.claudevoice.mobile.plugins.sms_send.ReportReceiver"
            android:exported="false" />
    </application>
</manifest>
